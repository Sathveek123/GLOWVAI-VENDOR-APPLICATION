# GlowVAI Vendor Backend — environment variables
# Copy to .env for local use. Placeholders only: never commit real values.
# On Render, set these in the service's Environment tab instead of a file.

# ── Server ────────────────────────────────────────────────────────────────────
# Render sets PORT itself; locally the default is 4000.
PORT=4000
# development | production. In production the server refuses to start without
# VENDOR_TOKEN_SECRET, ADMIN_API_KEY and Firebase credentials.
NODE_ENV=development
# Optional. Public base URL used for mock-mode image links (e.g. https://glowvai-vendor-api.onrender.com).
# Defaults to the request's own host.
PUBLIC_BASE_URL=

# ── Security ──────────────────────────────────────────────────────────────────
# HMAC secret that signs vendor session tokens. At least 32 characters in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VENDOR_TOKEN_SECRET=replace-with-64-random-hex-characters
# Admin key sent as the x-admin-key header on /api/admin/* routes. At least 24 characters in production.
ADMIN_API_KEY=replace-with-a-long-random-admin-key
# Development only: the OTP accepted by POST /api/auth/vendor/login. Ignored in production,
# where vendors sign in with a Firebase phone-auth ID token.
VENDOR_DEV_OTP=4892

# ── Firebase (leave the credentials empty to run in MOCK mode, data in memory) ─
FIREBASE_PROJECT_ID=glowvai-v2
# Service account key as one line of JSON, or the same JSON base64-encoded. Preferred on Render.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Local alternative: path to the key file, relative to backend/src. The file must stay out of git.
FIREBASE_SERVICE_ACCOUNT_PATH=../service-account.json
# Storage bucket for product images (Firebase console > Storage).
FIREBASE_STORAGE_BUCKET=glowvai-v2.firebasestorage.app
FIREBASE_DATABASE_URL=https://glowvai-v2-default-rtdb.firebaseio.com
# Off by default. Set to true only for a local emulator; it writes to the Realtime Database without credentials.
FIREBASE_DIRECT_SYNC=false

# ── CORS ──────────────────────────────────────────────────────────────────────
# Always allowed: https://glowvai.in, https://www.glowvai.in, http://localhost:3100.
# Outside production any http://localhost:<port> is allowed too. Add more, comma-separated:
ALLOWED_ORIGINS=

# ── Rate limit (per IP, in-memory) ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=2000
