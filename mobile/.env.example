# GlowVai Vendor app: environment
# Copy to mobile/.env (git-ignored) and adjust. Every EXPO_PUBLIC_* value is
# inlined into the app bundle, so never put a secret here.

# Vendor API base URL: the GlowVai shop host, which serves /api/vendor/* (docs/VENDOR_API.md).
# Production value: https://glowvai.in
# Development: a local copy of the shop server, e.g. http://localhost:3000 (web) or
# http://<your LAN IP>:3000 (phone). Production builds refuse to start when this is missing,
# local, or not https:// (see src/config/env.ts). The Express backend in backend/ is retired.
EXPO_PUBLIC_VENDOR_API_URL=https://glowvai.in

# Customer shop URL used by the "Open GlowVai shop" button (optional).
EXPO_PUBLIC_CUSTOMER_APP_URL=

# Firebase web config: the shared GlowVai project glowvai-38bde
# (the same project as the shop and the admin panel). These are public
# identifiers, not secrets; access is controlled by Firestore and Storage rules.
EXPO_PUBLIC_FIREBASE_API_KEY=AIzaSyDlbmN3fUAXTUlPBO5OGASbwIOAraUPBgA
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=glowvai-38bde.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=glowvai-38bde
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=glowvai-38bde.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=353135878239
EXPO_PUBLIC_FIREBASE_APP_ID=1:353135878239:web:c51f7954ba875b522ffbea

# Seller support contact shown on status, support, bank and payout screens
EXPO_PUBLIC_SELLER_SUPPORT_EMAIL=
EXPO_PUBLIC_SELLER_SUPPORT_PHONE=
